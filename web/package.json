{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"validate:openapi": "node scripts/validate-openapi.mjs",
		"generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/generated.ts",
		"format": "prettier --write 'src/**/*.{ts,svelte,css}' --plugin prettier-plugin-svelte"
	},
	"devDependencies": {
		"@apidevtools/swagger-parser": "12.1.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^29.1.1",
		"openapi-typescript": "7.6.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1"
	}
}
